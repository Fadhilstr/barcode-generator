# ============================================================
# Wahana Express Scan - Environment Variables Template
# Salin file ini menjadi .env dan isi dengan konfigurasi aman:
#   cp .env.example .env
# ============================================================

# Environment: 'development' | 'production'
APP_ENV=development

# Mode Frontend: false = connect ke backend REST API Perl, true = mock local data
VITE_USE_LOCAL_DATA=false

# Base URL API (kosong = same-origin / diproxy oleh server)
VITE_API_BASE_URL=

# Proxy target untuk Vite/Quasar dev server
API_PROXY_TARGET=http://localhost:5000

# Backend Server Port
WAHANA_API_PORT=5000

# Keamanan JWT / Pre-auth Token (WAJIB diisi string acak kuat di produksi!)
WAHANA_TOKEN_SECRET=CHANGE_ME_TO_A_SECURE_RANDOM_SECRET_STRING_IN_PRODUCTION
WAHANA_TOKEN_TTL=86400

# Database Configuration (MariaDB / MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=wahana_scan
DB_USER=wahana_app
DB_PASS=CHANGE_ME_DB_PASSWORD

# SMTP Configuration untuk OTP Email
# CATATAN KEAMANAN: Jangan commit App Password ke repository git!
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_SECURE=false
SMTP_FROM_NAME=DIJAK EXPRESS
