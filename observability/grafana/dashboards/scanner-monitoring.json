{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "System Overview (API)",
      "type": "row"
    },
    {
      "id": 1,
      "title": "Total API Requests",
      "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "sum(http_requests_total) or vector(0)", "refId": "A" }
      ],
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short",
          "mappings": []
        }
      }
    },
    {
      "id": 2,
      "title": "API Success Rate",
      "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 5, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "(sum(http_requests_total{status=~\"2..\"}) / sum(http_requests_total) * 100) or vector(100)", "refId": "A" }
      ],
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 90 },
              { "color": "green", "value": 98 }
            ]
          },
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      }
    },
    {
      "id": 3,
      "title": "API Errors (4xx / 5xx)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 10, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "sum(http_errors_total) or vector(0)", "refId": "A" }
      ],
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 5 },
              { "color": "red", "value": 20 }
            ]
          },
          "unit": "short"
        }
      }
    },
    {
      "id": 4,
      "title": "Avg API Response Time",
      "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 15, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "(sum(rate(http_request_duration_seconds_sum[1m])) / sum(rate(http_request_duration_seconds_count[1m])) * 1000) or vector(0)", "refId": "A" }
      ],
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "ms"
        }
      }
    },
    {
      "id": 5,
      "title": "Active Requests",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "sum(active_requests) or vector(0)", "refId": "A" }
      ],
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "orange", "value": 20 },
              { "color": "red", "value": 50 }
            ]
          },
          "unit": "short"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 200,
      "title": "Scanner Barcode Overview",
      "type": "row"
    },
    {
      "id": 11,
      "title": "Total Scans",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "sum(scanner_scans_total) or vector(0)", "refId": "A" }
      ],
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "#3B82F6", "mode": "fixed" },
          "unit": "short"
        }
      }
    },
    {
      "id": 12,
      "title": "Successful Scans",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "sum(scanner_scan_success_total) or vector(0)", "refId": "A" }
      ],
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "#10B981", "mode": "fixed" },
          "unit": "short"
        }
      }
    },
    {
      "id": 13,
      "title": "Duplicate Scans",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "sum(scanner_scan_duplicate_total) or vector(0)", "refId": "A" }
      ],
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "#F59E0B", "mode": "fixed" },
          "unit": "short"
        }
      }
    },
    {
      "id": 14,
      "title": "Failed / Rejected Scans",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "sum(scanner_scan_error_total) or vector(0)", "refId": "A" }
      ],
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "#EF4444", "mode": "fixed" },
          "unit": "short"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 10 },
      "id": 300,
      "title": "Scan Performance & Barcode Format Analysis",
      "type": "row"
    },
    {
      "id": 21,
      "title": "Scans Breakdown by Barcode Format",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 11 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "sum by (format) (scanner_scans_total) > 0", "legendFormat": "{{format}}", "refId": "A" }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] },
        "pieType": "donut",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      }
    },
    {
      "id": 22,
      "title": "Average Decode Duration by Format (Detik / Seconds)",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 11 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "(sum by (format) (scanner_decode_duration_seconds_sum) / sum by (format) (scanner_decode_duration_seconds_count)) > 0",
          "legendFormat": "{{format}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "color": { "mode": "palette-classic" }
        }
      },
      "options": {
        "showValue": "always",
        "legend": { "displayMode": "table", "placement": "bottom", "values": ["value"] }
      }
    },
    {
      "id": 23,
      "title": "Scan Events Timeline (Rate / min)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 11 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "sum(rate(scanner_scan_success_total[1m])) * 60", "legendFormat": "Success", "refId": "A" },
        { "expr": "sum(rate(scanner_scan_duplicate_total[1m])) * 60", "legendFormat": "Duplicate", "refId": "B" },
        { "expr": "sum(rate(scanner_scan_error_total[1m])) * 60", "legendFormat": "Error / Rejected", "refId": "C" }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 20, "gradientMode": "opacity" },
          "unit": "req/m"
        }
      }
    },
    {
      "id": 24,
      "title": "Rincian Durasi Scan Seluruh Format Barcode (Detik & Milidetik)",
      "type": "table",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum by (format) (scanner_scans_total)",
          "instant": true,
          "format": "table",
          "refId": "A"
        },
        {
          "expr": "sum by (format) (scanner_decode_duration_seconds_sum) / sum by (format) (scanner_decode_duration_seconds_count)",
          "instant": true,
          "format": "table",
          "refId": "B"
        },
        {
          "expr": "(sum by (format) (scanner_decode_duration_seconds_sum) / sum by (format) (scanner_decode_duration_seconds_count)) * 1000",
          "instant": true,
          "format": "table",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": { "align": "auto" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Value #A" },
            "properties": [
              { "id": "displayName", "value": "Total Scans" },
              { "id": "unit", "value": "short" },
              { "id": "decimals", "value": 0 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Value #B" },
            "properties": [
              { "id": "displayName", "value": "Rata-rata Durasi (Detik)" },
              { "id": "unit", "value": "s" },
              { "id": "decimals", "value": 4 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Value #C" },
            "properties": [
              { "id": "displayName", "value": "Rata-rata Durasi (ms)" },
              { "id": "unit", "value": "ms" },
              { "id": "decimals", "value": 1 }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "format",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true
            },
            "renameByName": {
              "format": "Format Barcode"
            },
            "indexByName": {
              "format": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3
            }
          }
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "id": 400,
      "title": "API Performance & Error Diagnostics",
      "type": "row"
    },
    {
      "id": 31,
      "title": "API Request Rate by Endpoint",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "sum by (endpoint, method) (rate(http_requests_total[1m])) * 60", "legendFormat": "{{method}} {{endpoint}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "req/m" }
      }
    },
    {
      "id": 32,
      "title": "API Response Duration Percentiles (P50, P90, P99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket[1m]))) * 1000", "legendFormat": "P50 (Median)", "refId": "A" },
        { "expr": "histogram_quantile(0.90, sum by (le) (rate(http_request_duration_seconds_bucket[1m]))) * 1000", "legendFormat": "P90", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket[1m]))) * 1000", "legendFormat": "P99", "refId": "C" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms" }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 36 },
      "id": 500,
      "title": "Infrastructure Metrics (Docker & System)",
      "type": "row"
    },
    {
      "id": 41,
      "title": "CPU Usage by Container (%)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 37 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name=~\"wahana.*\"}[1m])) * 100", "legendFormat": "{{name}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0 }
      }
    },
    {
      "id": 42,
      "title": "Memory Usage by Container (MB)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 37 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "container_memory_working_set_bytes{name=~\"wahana.*\"}", "legendFormat": "{{name}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "bytes" }
      }
    },
    {
      "id": 43,
      "title": "Network I/O Rate (KB/s)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 37 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "sum by (name) (rate(container_network_receive_bytes_total{name=~\"wahana.*\"}[1m]))", "legendFormat": "{{name}} In", "refId": "A" },
        { "expr": "sum by (name) (rate(container_network_transmit_bytes_total{name=~\"wahana.*\"}[1m]))", "legendFormat": "{{name}} Out", "refId": "B" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "Bps" }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 44 },
      "id": 600,
      "title": "Live Logs Explorer (Loki)",
      "type": "row"
    },
    {
      "id": 51,
      "title": "Scanner & Backend Logs (ERROR / WARN / SCAN_SUCCESS / API_ERROR)",
      "type": "logs",
      "gridPos": { "h": 12, "w": 14, "x": 0, "y": 45 },
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [
        {
          "expr": "{service=~\"backend|scanner|observability\"}",
          "refId": "A"
        }
      ],
      "options": {
        "showLabels": false,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    },
    {
      "id": 52,
      "title": "Nginx Access & Gateway Logs",
      "type": "logs",
      "gridPos": { "h": 12, "w": 10, "x": 14, "y": 45 },
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [
        {
          "expr": "{service=\"nginx\"}",
          "refId": "A"
        }
      ],
      "options": {
        "showLabels": false,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["wahana", "scanner", "observability"],
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"],
    "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "2d", "7d", "30d"]
  },
  "timezone": "Asia/Jakarta",
  "title": "Scanner Barcode Express — System Monitoring",
  "uid": "scanner-monitoring",
